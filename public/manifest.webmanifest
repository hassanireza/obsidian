{
  "id": "./",
  "name": "Obsidian Game Store",
  "short_name": "Obsidian",
  "description": "A quiet catalog of small, well made browser games.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
